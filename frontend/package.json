{
  "name": "goldsight-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "android:init": "npm run build && cap add android && python scripts/prepare-android.py && cap sync android",
    "android:sync": "npm run build && python scripts/prepare-android.py && cap sync android",
    "android:open": "cap open android",
    "ios:init": "npm run build && cap add ios && cap sync ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.1",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@capacitor/cli": "^8.6.0"
  }
}
