{
  "name": "tradesight-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:add:android": "cap add android",
    "cap:sync:android": "npm run cap:android:prepare && cap sync android",
    "cap:android:prepare": "node scripts/prepare-android-native.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
